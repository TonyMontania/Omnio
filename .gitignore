# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules

# Build outputs (regenerated by `npm run build` / `cargo build`)
dist
dist-ssr
release
*.tsbuildinfo
# Cargo build artifacts (~5-8 GB in debug + release). The nested
# .gitignore under src-tauri/ also covers this; belt and braces.
src-tauri/target/
src-tauri/gen/

# User data — never commit anyone's actual library
data.json
# Only ignore the root-level assets/ folder (user covers, banners,
# save files, screenshots). Bundled UI assets live under src/assets/
# and MUST ship with the source.
/assets/

# Local backup dirs left by the refactor work
src.backup*

# Local overrides
*.local

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code project settings and cache
.claude/


